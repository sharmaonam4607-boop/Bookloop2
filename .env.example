# Project Metadata
PROJECT_NAME="BookLoop - Giving Books a Second Chance"
ENVIRONMENT=development
API_V1_STR=/api/v1

# PostgreSQL Configuration
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=bookloop

# Full Database URL (SQLAlchemy compatible PostgreSQL URI)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/bookloop

# CORS Settings (JSON list of allowed frontend origins)
BACKEND_CORS_ORIGINS=["http://localhost", "http://localhost:3000", "http://localhost:8000", "http://localhost:5500", "http://127.0.0.1:5500", "http://127.0.0.1:8000", "http://127.0.0.1:3000", "null"]
